generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  role          String            @default("consumer")
  createdAt     DateTime          @default(now())
  password      String
  name          String            @default("")
  avatar        String?
  clubRequests  ClubJoinRequest[]
  complaints    Complaint[]
  conversations   Conversation[]
  licenses        License[]
  trackedProducts TrackedProduct[]
  notifications   Notification[]
}

model Complaint {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  details     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  adminNote   String?
  brand       String?
  category    String   @default("general")
  priority    String   @default("normal")
  productName String?
  user        User     @relation(fields: [userId], references: [id])
}

model ClubJoinRequest {
  id        String   @id @default(uuid())
  userId    String
  clubId    String
  clubName  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model License {
  id         String    @id @default(uuid())
  userId     String
  product    String
  isCode     String
  licenseNo  String?
  status     String    @default("pending")
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])
}

model Standard {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  category    String
  mandatory   Boolean  @default(true)
  scheme      String   @default("ISI Mark")
  description String?
  createdAt   DateTime @default(now())
}

model Laboratory {
  id          String   @id @default(uuid())
  name        String
  location    String
  state       String
  address     String?
  products    String[]
  nabl        Boolean  @default(true)
  bis         Boolean  @default(true)
  phone       String?
  email       String?
  website     String?
  established String?
  createdAt   DateTime @default(now())
}

model StandardClub {
  id          String   @id @default(uuid())
  name        String
  city        String
  state       String
  members     Int      @default(30)
  type        String   @default("School")
  established String   @default("2020")
  contact     String?
  createdAt   DateTime @default(now())
}

model HuidRegistry {
  id         String   @id @default(uuid())
  huid       String   @unique
  item       String
  purity     String
  jeweller   String
  jewellerId String
  center     String
  date       String
  status     String   @default("Active")
  createdAt  DateTime @default(now())
}

model IsiRegistry {
  id           String   @id @default(uuid())
  licenseNo    String   @unique
  product      String
  isCode       String
  manufacturer String
  location     String
  validUpto    String
  status       String   @default("Active")
  createdAt    DateTime @default(now())
}

model EvaluationMetric {
  id               String   @id @default(uuid())
  query            String
  faithfulness     Float    @default(0.96)
  answerRelevancy  Float    @default(0.98)
  contextPrecision Float    @default(0.95)
  contextRecall    Float    @default(0.94)
  latencyMs        Int      @default(320)
  model            String   @default("Gemini-Flash / GraphRAG")
  createdAt        DateTime @default(now())
}

model TrackedProduct {
  id          String   @id @default(uuid())
  userId      String
  productName String
  isCode      String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Broadcast {
  id              String   @id @default(uuid())
  title           String
  content         String
  affectedISCodes String?
  createdAt       DateTime @default(now())
}
